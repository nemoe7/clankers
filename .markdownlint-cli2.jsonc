{
  "globs": [
    "**/*.md",
    "!**/AGENTS.md",
    "!**/ARENA.md",
    "!rules/**/!(README).md",
    "!skills/**/!(README).md",
    "!gpt-plugins/skills/**/!(README).md",
    "!gpt-plugins/refs/**/!(README).md",
    "!system-prompts/**/!(README).md",
    "!docs/archive/**/!(README).md",
    "!.agents/**",
    "!.kilo/**"
  ],
  "gitignore": true,
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD060": true
  }
}
